[Unit]
Description=locai llama-server router on the Intel Arc Pro B60 (port 9704)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=llm
Group=llm
Environment=HOME=/home/llm
# optional overrides (the leading "-" means the file may be missing)
EnvironmentFile=-/home/llm/locai/llama/b60.env
ExecStart=/home/llm/locai/llama/start-b60.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
# stop the router and every model process it started
KillMode=control-group

[Install]
WantedBy=multi-user.target
